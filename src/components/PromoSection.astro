---
// src/components/PromoSection.astro

const promos = [
  {
    type: 'active',
    title: 'Bundle 6 Jar Ostekake',
    priceInfo: 'Cuma 169K (Normal 218.5K)',
    image: '/images/promo.png',
    ctaLink: 'https://wa.me/6281524321194?text=Hi!%20I\'m%20interested%20in%20the%20Bundle%20of%206%20Ostekake%20Promo%20for%20169K!'
  },
  {
    type: 'active',
    title: 'Wednesday Treat',
    priceInfo: 'Diskon 10% Semua Varian (Hari Rabu Only)',
    image: '/images/wed-treat.webp',
    ctaLink: 'https://wa.me/6281524321194?text=Hi!%20I\'m%20interested%20in%20the%20Promo%20Kemerdekaan%20Diskon%2010%25!'
  },
  {
    type: 'placeholder',
    title: 'Stay Tuned!',
    subtitle: 'Nantikan promo menarik berikutnya khusus untuk kamu.'
  }
];
---

<section class="bg-[#FDF6E2] w-full py-10 md:py-14">
  <!-- Title Section -->
  <div class="text-center mb-10">
    <h2 class="text-gray-950 text-2xl md:text-3xl font-bold">Special Offer Dari Kami</h2>
    <p class="text-gray-500 text-sm md:text-base mt-2">Nikmati penawaran spesial terbatas khusus untuk kamu!</p>
  </div>

  <!-- Adaptive Grid System -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto px-4">
    {promos.map((promo) => (
      promo.type === 'active' ? (
        <a 
          href={promo.ctaLink} 
          target="_blank" 
          rel="noopener noreferrer" 
          class="group block bg-white rounded-2xl shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-300 overflow-hidden flex flex-col"
        >
          <div class="w-full">
            <img 
              src={promo.image} 
              alt={promo.title} 
              class="w-full object-cover aspect-[4/3]" 
              loading="lazy" 
            />
          </div>
          <div class="p-5 flex flex-col justify-between flex-1">
            <div>
              <h3 class="text-gray-900 font-bold text-lg leading-tight">{promo.title}</h3>
              <p class="text-amber-600 font-medium text-sm mt-1">{promo.priceInfo}</p>
            </div>
            <button class="w-full mt-5 bg-[#D4A373] hover:bg-[#C28E5C] text-white font-semibold py-2.5 rounded-xl transition-colors duration-200">
              Ambil Promo
            </button>
          </div>
        </a>
      ) : (
        <div class="bg-amber-50 border-2 border-dashed border-amber-200 rounded-2xl flex flex-col items-center justify-center p-8 text-center min-h-[300px]">
          <svg class="w-12 h-12 text-amber-400 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
          <h3 class="text-gray-800 font-bold text-xl">{promo.title}</h3>
          <p class="text-gray-500 text-sm mt-2 leading-relaxed">{promo.subtitle}</p>
        </div>
      )
    ))}
  </div>
</section>
