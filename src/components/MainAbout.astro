---
import HeroSlider from './HeroSlider.jsx';
---

<section id="home" class="bg-[#FDF6E2] w-full relative overflow-hidden">
  <div class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto h-full flex flex-col justify-center">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8 items-center h-full">
      
      <!-- Left Column: Hero Texts -->
      <div class="flex flex-col text-center md:text-left z-10 h-full justify-center pt-8 md:pt-0">
        <div class="flex-grow flex flex-col justify-center">
          <h1 class="font-viga text-5xl sm:text-6xl md:text-6xl lg:text-7xl xl:text-[5.5rem] leading-[1.1] text-gray-950 mb-6 tracking-tight">
            First Ever <span class="text-[#1E3A8A]">Norwegian</span><br class="hidden lg:block" />
            Ostekake In Indonesia
          </h1>
          
          <p class="font-zain text-xl sm:text-2xl lg:text-3xl text-gray-600 leading-relaxed max-w-xl mx-auto md:mx-0">
            Re-Engineering the way you enjoy cheese.<br />
            Light, velvet-smooth, never boring.
          </p>
        </div>

        <!-- Location Footer Address -->
        <div class="mt-12 md:mt-auto pt-8">
          <a href="https://maps.app.goo.gl/zx9Tf3zeXuY6XhzS8" target="_blank" rel="noopener noreferrer" class="text-[10px] sm:text-xs text-[#1E3A8A] font-medium tracking-wide hover:underline hover:text-blue-800 transition-colors">
            Nusa Loka Park BSD, Plaza Cordoba, Jl. Mekar Jaya Blok M08, Banten, Kec. Serpong
          </a>
        </div>
      </div>

      <!-- Right Column: Product Visual Interactive React Slider -->
      <HeroSlider client:load />
      
    </div>
  </div>
</section>
