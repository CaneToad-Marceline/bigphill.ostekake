---
// src/components/ResellerB2B.astro
---

<section id="partnership" class="w-full bg-[#FDF6E2] overflow-hidden relative font-sans">
  <div class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <div class="flex flex-col md:grid md:grid-cols-2 items-center gap-10 md:gap-12">
      
      {/* Left Column: B2B Marketing Texts & Action Buttons */}
      <div class="flex flex-col items-center md:items-start text-center md:text-left h-full justify-center">
        
        <h2 class="text-5xl md:text-6xl lg:text-7xl font-extrabold text-gray-900 tracking-tight leading-[1.1] mb-4">
          Want our Product in your <br class="hidden lg:block" />
          <span class="text-[#7C5CB7]">Business?</span>
        </h2>
        
        <p class="text-lg md:text-xl text-[#53658C] font-semibold mb-8">
          Click Underneath To Work With Us !
        </p>

        {/* Action Buttons */}
        <div class="flex flex-col gap-4 w-full max-w-[280px]">
          
          {/* WhatsApp Button */}
          <a 
            href="https://wa.me/c/6281524321194" target="_blank" rel="noopener noreferrer"
            class="flex items-center gap-4 bg-[#FFB84D] text-gray-900 font-bold text-lg py-3.5 px-6 rounded-2xl hover:scale-105 transition-transform duration-300 ease-out shadow-[0px_4px_14px_rgba(255,184,77,0.4)] hover:shadow-[0px_6px_20px_rgba(255,184,77,0.6)] border-2 border-[#FFB84D] hover:border-gray-900 group"
          >
            <svg xmlns="http://www.w3.org/0000.svg" class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path>
            </svg>
            <span class="flex-grow text-center pr-4">Contact Whatsapp</span>
          </a>

          {/* Email Button */}
          <a 
            href="#"
            class="flex items-center gap-4 bg-[#FFB84D] text-gray-900 font-bold text-lg py-3.5 px-6 rounded-2xl hover:scale-105 transition-transform duration-300 ease-out shadow-[0px_4px_14px_rgba(255,184,77,0.4)] hover:shadow-[0px_6px_20px_rgba(255,184,77,0.6)] border-2 border-[#FFB84D] hover:border-gray-900 group"
          >
            <svg xmlns="http://www.w3.org/0000.svg" class="w-7 h-7 flex-shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="4" width="20" height="16" rx="2"></rect>
              <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
            </svg>
            <span class="flex-grow text-center pr-4">Email us</span>
          </a>

        </div>

        {/* Legal Note */}
        <a href="#" class="mt-6 text-sm font-semibold text-[#53658C] hover:text-[#7C5CB7] transition-colors hover:underline">
          Terms & Condition
        </a>

        {/* Footer Address */}
        <div class="mt-16 md:mt-auto pt-8">
          <p class="text-[10px] sm:text-xs text-gray-400 font-medium tracking-wide max-w-[250px] md:max-w-xs text-center md:text-left leading-relaxed">
            Nusa Loka Park BSD, Plaza Cordoba, Jl. Mekar Jaya Blok M08, Banten, Kec. Serpong
          </p>
        </div>

      </div>

      {/* Right Column: Visual Auto-Swipe Carousel */}
      <div class="relative w-full overflow-hidden flex items-center h-[350px] md:h-[550px] mt-8 md:mt-0">
        
        {/* Soft edge masks for blending */}
        <div class="absolute inset-y-0 left-0 w-16 md:w-32 bg-gradient-to-r from-[#FDF6E2] to-transparent z-10 pointer-events-none"></div>
        <div class="absolute inset-y-0 right-0 w-16 md:w-32 bg-gradient-to-l from-[#FDF6E2] to-transparent z-10 pointer-events-none"></div>

        {/* Carousel Track */}
        <div class="flex animate-carousel w-max group">
          {/* First set of 6 products */}
          <div class="flex items-center">
            {[
              "/images/product-signature-original.png",
              "/images/product-signature-cathy.png",
              "/images/product-signature-fiona.png",
              "/images/product-signature-hana.png",
              "/images/product-premium-helena.png",
              "/images/product-premium-victoria.png",
            ].map((src, i) => (
              <div class="w-[260px] md:w-[380px] flex-shrink-0 flex justify-center px-4 md:px-8">
                <img 
                  src={src} 
                  alt="Big Phil Ostekake Product" 
                  class="w-full h-auto object-contain drop-shadow-2xl hover:scale-110 hover:-translate-y-4 transition-all duration-500 ease-out"
                  loading={i < 2 ? "eager" : "lazy"} 
                />
              </div>
            ))}
          </div>

          {/* Duplicated set for seamless infinite loop */}
          <div class="flex items-center">
            {[
              "/images/product-signature-original.png",
              "/images/product-signature-cathy.png",
              "/images/product-signature-fiona.png",
              "/images/product-signature-hana.png",
              "/images/product-premium-helena.png",
              "/images/product-premium-victoria.png",
            ].map((src) => (
              <div class="w-[260px] md:w-[380px] flex-shrink-0 flex justify-center px-4 md:px-8">
                <img 
                  src={src} 
                  alt="Big Phil Ostekake Product" 
                  class="w-full h-auto object-contain drop-shadow-2xl hover:scale-110 hover:-translate-y-4 transition-all duration-500 ease-out"
                  loading="lazy" 
                />
              </div>
            ))}
          </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes carousel {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  .animate-carousel {
    animation: carousel 35s linear infinite;
  }
  .animate-carousel:hover {
    animation-play-state: paused;
  }
</style>
