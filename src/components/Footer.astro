---
// src/components/Footer.astro
---

<footer class="w-full bg-[#E5E5E5] font-sans border-t border-gray-300">
  <div class="pt-16 pb-8 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto w-full">
    
    <div class="flex flex-col md:grid md:grid-cols-6 gap-12 md:gap-8 items-center md:items-start text-center md:text-left">
      
      {/* Branding Column */}
      <div class="md:col-span-1 flex flex-col items-center md:items-start">
        <img src="/logos/blacklogo.svg" alt="Big Phil Ostekake" class="h-20 md:h-24 w-auto mb-4 object-contain" />
        <p class="text-xs md:text-sm text-gray-600 font-bold max-w-[150px]">
          First Ostekake in Indonesia
        </p>
      </div>

      {/* Column 1: About Us */}
      <div class="flex flex-col gap-4 w-full">
        <h3 class="font-extrabold text-gray-900 text-lg md:text-xl">About Us</h3>
        <ul class="flex flex-col gap-3 text-sm text-gray-600 font-semibold">
          <li><a href="https://maps.app.goo.gl/zx9Tf3zeXuY6XhzS8" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-amber-600 transition-colors">Our Location</a></li>
          <li><a href="#" class="hover:underline hover:text-amber-600 transition-colors">Our Story</a></li>
          <li class="text-gray-500 leading-relaxed mt-1">Operational Time<br/>(10.00 - 20.00)</li>
        </ul>
      </div>

      {/* Column 2: Our Series */}
      <div class="flex flex-col gap-4 w-full">
        <h3 class="font-extrabold text-gray-900 text-lg md:text-xl">Our Series</h3>
        <ul class="flex flex-col gap-3 text-sm text-gray-600 font-semibold">
          <li><a href="#menu" data-menu-select='{"category":"Signature","id":"Original"}' class="menu-link hover:underline hover:text-amber-600 transition-colors">Original Ostekake</a></li>
          <li><a href="#menu" data-menu-select='{"category":"Premium","id":"Helena"}' class="menu-link hover:underline hover:text-amber-600 transition-colors">Premium Series</a></li>
          <li><a href="#menu" data-menu-select='{"category":"Signature","id":"Original"}' class="menu-link hover:underline hover:text-amber-600 transition-colors">Signature Series</a></li>
        </ul>
      </div>

      {/* Column 3: Find Us On */}
      <div class="flex flex-col gap-4 w-full">
        <h3 class="font-extrabold text-gray-900 text-lg md:text-xl">Find Us On</h3>
        <ul class="flex flex-col gap-3 text-sm text-gray-600 font-semibold">
          <li><a href="https://gofood.link/a/TRdyr7L" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-amber-600 transition-colors">GoFood</a></li>
          <li><a href="https://r.grab.com/g/6-20260702_163655_EFB30F15F7C442C1947C0CFD5BA14BE3_MEXMPS-6-C8BDRRBUJAVHCA" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-amber-600 transition-colors">GrabFood</a></li>
          <li><a href="https://shopee.co.id/universal-link/now-food/shop/23268075?deep_and_deferred=1&shareChannel=copy_link" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-amber-600 transition-colors">ShopeeFood</a></li>
          <li><a href="https://wa.me/c/6281524321194" target="_blank" rel="noopener noreferrer" class="hover:underline hover:text-amber-600 transition-colors">Catalog</a></li>
        </ul>
      </div>

      {/* Column 4: Connect */}
      <div class="flex flex-col gap-4 w-full">
        <h3 class="font-extrabold text-gray-900 text-lg md:text-xl">Connect</h3>
        <ul class="flex flex-col gap-3 text-sm text-gray-600 font-semibold">
          <li><a href="#" class="hover:underline hover:text-amber-600 transition-colors">Consignment Info</a></li>
          <li><a href="tel:+6281524321184" class="hover:underline hover:text-amber-600 transition-colors">+6281524321184</a></li>
          <li><a href="mailto:bigphil.ostekake@gmail.com" class="hover:underline hover:text-amber-600 transition-colors break-all">bigphil.ostekake@gmail.com</a></li>
        </ul>
      </div>

      {/* Column 5: Follow Us */}
      <div class="flex flex-col gap-4 items-center md:items-start w-full">
        <h3 class="font-extrabold text-gray-900 text-lg md:text-xl">Follow Us</h3>
        <div class="flex items-center gap-5 mt-1">
          {/* Instagram Icon */}
          <a href="https://www.instagram.com/bigphil_officialstore/" target="_blank" rel="noopener noreferrer" class="text-gray-900 hover:text-amber-600 transition-colors hover:scale-110 transform ease-out duration-300">
            <svg xmlns="http://www.w3.org/0000.svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
              <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
              <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
            </svg>
          </a>
          {/* Facebook Icon */}
          <a href="#" target="_blank" rel="noopener noreferrer" class="text-gray-900 hover:text-amber-600 transition-colors hover:scale-110 transform ease-out duration-300">
            <svg xmlns="http://www.w3.org/0000.svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
            </svg>
          </a>
        </div>
      </div>

    </div>

    {/* Bottom Bar Details */}
    <div class="mt-16 md:mt-24 pt-8 border-t border-gray-300 flex flex-col md:flex-row justify-between items-center gap-6 text-xs font-bold text-gray-500">
      <div class="order-2 md:order-1 tracking-wide">
        © 2026 BigPhilOstekake
      </div>
      <div class="flex gap-8 order-1 md:order-2">
        <a href="#" class="hover:underline hover:text-amber-600 transition-colors">Terms & Condition</a>
        <a href="#" class="hover:underline hover:text-amber-600 transition-colors">Privacy Policy</a>
      </div>
    </div>

  </div>
</footer>

<script>
  // Add interactive custom event dispatching to footer menu links
  document.addEventListener('DOMContentLoaded', () => {
    const menuLinks = document.querySelectorAll('.menu-link');
    menuLinks.forEach(link => {
      link.addEventListener('click', (e) => {
        const rawData = link.getAttribute('data-menu-select');
        if (rawData) {
          const data = JSON.parse(rawData);
          // Dispatch event to ProductMenu.jsx to open exact tab
          window.dispatchEvent(new CustomEvent('selectProduct', { detail: data }));
        }
      });
    });
  });
</script>
