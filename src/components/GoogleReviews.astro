---
// src/components/GoogleReviews.astro

const reviews = [
  {
    name: "Nachdya G. Alkaaf",
    image: "/images/customer-review1.png",
    stars: 5,
    text: "nyobain dessert yg baru buka dket kantor, enakk bgt buat nyemil mesen yg oreo sm ferreroo, toppingnya beneran coklat ferrero trnyata",
    link: "https://maps.app.goo.gl/FYTkYfdZ9aTLAzJM7"
  },
  {
    name: "Melati Puspa",
    image: "/images/customer-review2.png",
    stars: 5,
    text: "Enak sekaliii, tidak kemanisan, rasanya balance 😍 jadi ga enek, enaaakkkk",
    link: "https://maps.app.goo.gl/p8WHt1T6wp14uF296"
  },
  {
    name: "bahrul alam",
    image: "/images/customer-review3.png",
    stars: 5,
    text: "Creamy dan cheesy, balance ga kemanisan buat varian originalnya. Highly recommended ostekake 👍🏻 …",
    link: "https://maps.app.goo.gl/purNfoinkZNQzJbw8"
  }
];
---

<section id="reviews" class="w-full bg-[#FDF6E2] font-sans">
  <div class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
    
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight">
        What Our <span class="text-[#7C5CB7]">Customers Say</span>
      </h2>
      <p class="mt-4 text-lg text-gray-600 font-medium">Real reviews from Google Maps</p>
    </div>

    {/* Responsive 3-Column Grid */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {reviews.map((review) => (
        <a 
          href={review.link} 
          target="_blank" 
          rel="noopener noreferrer"
          class="block bg-white rounded-2xl p-6 md:p-8 shadow-sm hover:shadow-lg hover:-translate-y-1 transition-all duration-300 ease-out border border-transparent hover:border-gray-100 group flex flex-col h-full"
        >
          {/* User Profile Row */}
          <div class="flex items-center gap-4 mb-5">
            <div class="w-10 h-10 md:w-12 md:h-12 rounded-full overflow-hidden bg-gray-100 flex-shrink-0 shadow-sm border border-gray-100">
              {/* Added an onerror fallback just in case the placeholder images are missing, so the layout never breaks */}
              <img 
                src={review.image} 
                alt={`${review.name} profile`} 
                class="w-full h-full object-cover"
                loading="lazy"
                onerror="this.onerror=null; this.src='https://www.gravatar.com/avatar/00000000000000000000000000000000?d=mp&f=y';"
              />
            </div>
            <div>
              <h3 class="font-bold text-gray-900 group-hover:text-[#7C5CB7] transition-colors leading-tight">{review.name}</h3>
              {/* Star Ratings */}
              <div class="flex items-center gap-1 mt-1">
                {Array.from({ length: review.stars }).map(() => (
                  <svg xmlns="http://www.w3.org/0000.svg" viewBox="0 0 24 24" fill="#FFB84D" class="w-4 h-4 drop-shadow-sm">
                    <path fill-rule="evenodd" d="M10.788 3.21c.448-1.077 1.976-1.077 2.424 0l2.082 5.007 5.404.433c1.164.093 1.636 1.545.749 2.305l-4.117 3.527 1.257 5.273c.271 1.136-.964 2.033-1.96 1.425L12 18.354 7.373 21.18c-.996.608-2.231-.29-1.96-1.425l1.257-5.273-4.117-3.527c-.887-.76-.415-2.212.749-2.305l5.404-.433 2.082-5.006z" clip-rule="evenodd" />
                  </svg>
                ))}
              </div>
            </div>
          </div>
          
          {/* Review Text */}
          <p class="text-gray-600 leading-relaxed text-sm md:text-base italic flex-grow">
            "{review.text}"
          </p>
          
          {/* Footer Call To Action / Source */}
          <div class="mt-6 pt-4 border-t border-gray-50 flex justify-between items-center text-xs text-gray-400 font-semibold">
            <span class="flex items-center gap-1.5">
              <svg xmlns="http://www.w3.org/0000.svg" class="w-4 h-4 text-[#EA4335]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z"/>
              </svg>
              Google Maps
            </span>
            <span class="opacity-0 translate-x-[-10px] group-hover:translate-x-0 group-hover:opacity-100 transition-all duration-300 ease-out flex items-center gap-1 text-[#7C5CB7]">
              View Review <span class="text-lg leading-none">&rarr;</span>
            </span>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
