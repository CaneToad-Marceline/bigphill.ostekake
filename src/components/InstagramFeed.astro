---
// src/components/InstagramFeed.astro
---

<section id="instagram-updates" class="w-full bg-[#FDF6E2] font-sans">
  <div class="py-16 md:py-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto text-center">
    
    <h2 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-gray-900 tracking-tight mb-12">
      Check Our Latest <span class="text-[#7C5CB7]">Update</span>
    </h2>

    {/* Responsive Instagram Grid */}
    <div id="instagram-grid" class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-2"></div>

  </div>
</section>

<script>
  (async function() {
    const BEHOLD_URL = "MASUKKAN_URL_JSON_BEHOLD_DI_SINI";
    const container = document.getElementById('instagram-grid');
    
    if (!container) return;

    try {
      const response = await fetch(BEHOLD_URL);
      
      if (!response.ok) {
        throw new Error(`Failed to fetch Instagram feed: ${response.status} ${response.statusText}`);
      }
      
      const data = await response.json();
      
      // Safely extract the array of posts depending on exact Behold.so JSON structure
      const postArray = Array.isArray(data) ? data : (data.posts || []);
      
      // Strictly slice to only the top 4 latest posts
      const posts = postArray.slice(0, 4);

      let htmlContent = '';

      posts.forEach(post => {
        // CRITICAL THUMBNAIL FIXED LOGIC
        const imgSrc = post.mediaType === "VIDEO" ? post.thumbnailUrl : post.mediaUrl;
        const safeAltText = (post.caption || "Big Phil Ostekake Update").replace(/"/g, '&quot;');
        
        htmlContent += `
          <a 
            href="${post.permalink}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative block w-full aspect-square overflow-hidden bg-white/50 rounded-xl md:rounded-none shadow-sm md:shadow-none"
          >
            <img 
              src="${imgSrc}" 
              alt="${safeAltText}" 
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
            
            <!-- Premium Light Overlay Effect -->
            <div class="absolute inset-0 bg-white opacity-0 group-hover:opacity-15 transition-opacity duration-300 pointer-events-none"></div>
            
            <!-- Instagram Icon Overlay on Hover for premium UX -->
            <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none">
              <div class="bg-black/40 p-3 rounded-full backdrop-blur-sm">
                <svg xmlns="http://www.w3.org/0000.svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                  <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                  <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                </svg>
              </div>
            </div>
          </a>
        `;
      });

      // Inject the generated markup into the container
      container.innerHTML = htmlContent;

    } catch (error) {
      console.error("Error fetching Instagram posts from Behold.so:", error);
      
      // Fallback mock data to prevent build failures or empty states
      const fallbackPosts = [
        { permalink: "https://instagram.com/bigphil.ostekake", mediaUrl: "/images/product-signature-original.png" },
        { permalink: "https://instagram.com/bigphil.ostekake", mediaUrl: "/images/product-signature-cathy.png" },
        { permalink: "https://instagram.com/bigphil.ostekake", mediaUrl: "/images/product-signature-fiona.png" },
        { permalink: "https://instagram.com/bigphil.ostekake", mediaUrl: "/images/product-signature-hana.png" }
      ];

      let fallbackHtml = '';
      fallbackPosts.forEach(post => {
        fallbackHtml += `
          <a 
            href="${post.permalink}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="group relative block w-full aspect-square overflow-hidden bg-white/50 rounded-xl md:rounded-none shadow-sm md:shadow-none"
          >
            <img 
              src="${post.mediaUrl}" 
              alt="Big Phil Ostekake Update" 
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
            />
          </a>
        `;
      });
      container.innerHTML = fallbackHtml;
    }
  })();
</script>
