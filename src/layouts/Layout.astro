---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content="Nikmati kelembutan Big Phil Ostekake, kue keju autentik khas Norwegia pertama di Indonesia. Velvet-smooth, light, dan never boring. Pesan sekarang melalui GoFood, GrabFood, ShopeeFood, atau WhatsApp Catalog!" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon1.svg" />
    <link rel="shortcut icon" href="/favicon1.svg" type="image/svg+xml" />

    <!-- Primary Meta Tags -->
    <title>Big Phil Ostekake | First Ever Norwegian Ostekake In Indonesia</title>
    <meta name="title" content="Big Phil Ostekake | First Ever Norwegian Ostekake In Indonesia" />
    <meta name="keywords" content="bigphil, big phil, ostekake, big phil ostekake, ostekake indonesia, norwegian ostekake, norwegian cheesecake, kue ostekake, dessert premium serpong, kuliner gading serpong, bigphilostekake.id" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href="https://bigphilostekake.id" />

    <!-- Open Graph / Facebook / Social Media -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Big Phil Ostekake | First Ever Norwegian Ostekake In Indonesia" />
    <meta property="og:description" content="Nikmati kelembutan Big Phil Ostekake, kue keju autentik khas Norwegia pertama di Indonesia. Velvet-smooth, light, dan never boring. Pesan sekarang melalui GoFood, GrabFood, ShopeeFood, atau WhatsApp Catalog!" />
    <meta property="og:url" content="https://bigphilostekake.id" />
    <meta property="og:image" content="/images/main-hero-bg.webp" />

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Viga&family=Zain:wght@200;300;400;700;800;900&display=swap" rel="stylesheet">
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "Bakery",
        "name": "Big Phil Ostekake",
        "image": "https://bigphilostekake.id",
        "@id": "https://bigphilostekake.id",
        "url": "https://bigphilostekake.id",
        "telephone": "+6281524321184",
        "priceRange": "$$",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Piazza Carribean Blok B No 109, Beverli Lakes-Pakar",
          "addressLocality": "Gading Serpong, Pagedangan, Tangerang",
          "addressRegion": "Banten",
          "postalCode": "15810",
          "addressCountry": "ID"
        },
        "geo": {
          "@type": "GeoCoordinates",
          "latitude": -6.2625,
          "longitude": 106.6214
        },
        "openingHoursSpecification": {
          "@type": "OpeningHoursSpecification",
          "dayOfWeek": [
            "Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"
          ],
          "opens": "10:00",
          "closes": "20:00"
        }
      }
    </script>
    <!-- Meta Pixel Code -->
    <script is:inline>
      !function(f,b,e,v,n,t,s)
      {if(f.fbq)return;n=f.fbq=function(){n.callMethod?
      n.callMethod.apply(n,arguments):n.queue.push(arguments)};
      if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';
      n.queue=[];t=b.createElement(e);t.async=!0;
      t.src=v;s=b.getElementsByTagName(e)[0];
      s.parentNode.insertBefore(t,s)}(window, document,'script',
      'https://connect.facebook.net/en_US/fbevents.js');
      fbq('init', '928643769711995');
      fbq('track', 'PageView');
    </script>
    <noscript><img height="1" width="1" style="display:none" src="https://www.facebook.com/tr?id=928643769711995&ev=PageView&noscript=1" /></noscript>
    <!-- End Meta Pixel Code -->
  </head>
  <body>
    <slot />
    <Analytics />
  </body>
</html>
